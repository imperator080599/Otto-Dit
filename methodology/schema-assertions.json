{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OTTO — jeu d'assertions du cabinet",
  "type": "object",
  "required": ["version", "assertions"],
  "properties": {
    "_note": { "type": "string" },
    "version": { "type": "string" },
    "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/assertion" } }
  },
  "definitions": {
    "assertion": {
      "type": "object",
      "required": ["code", "libelle", "definition"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z_]+$" },
        "libelle": { "type": "string", "minLength": 5 },
        "definition": {
          "type": "string",
          "minLength": 40,
          "description": "Ce que l'assertion affirme, en toutes lettres. Une assertion qui ne dit pas ce qu'elle affirme ne se conteste pas en revue."
        },
        "sens_naturel": {
          "type": "string",
          "description": "Sens de test que cette assertion appelle d'ordinaire. Indicatif : une procédure garde le sien. Validé contre sens_de_test du catalogue."
        }
      }
    }
  }
}
