{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OTTO — évaluation du risque par assertion",
  "type": "object",
  "required": ["version", "facteurs_observes", "echelle", "tailles_echantillon"],
  "properties": {
    "_note": { "type": "string" },
    "version": { "type": "string" },
    "facteurs_observes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/facteur" } },
    "echelle": { "type": "object" },
    "tailles_echantillon": { "type": "object" }
  },
  "predicats_facteur": [
    "variation_n_n1_au_dessus_du_seuil",
    "nombre_ecritures_au_dessus_de",
    "part_journal_od_au_dessus_de",
    "ecritures_validees_apres_cloture",
    "part_dernier_mois_au_dessus_de"
  ],
  "definitions": {
    "facteur": {
      "type": "object",
      "required": ["code", "assertion", "libelle", "pourquoi", "predicat", "parametres", "sources"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z_]+$" },
        "assertion": {
          "enum": ["realite", "exhaustivite", "mesure", "evaluation", "separation", "droits", "presentation"]
        },
        "libelle": { "type": "string", "minLength": 10 },
        "pourquoi": {
          "type": "string",
          "minLength": 40,
          "description": "Pourquoi ce fait constitue un risque. Un facteur qui ne dit pas ce qu'il craint n'est pas un facteur, c'est une statistique."
        },
        "predicat": {
          "type": "string",
          "description": "Nom du prédicat implémenté côté code. Un prédicat hors de la liste `predicats_facteur` ARRÊTE l'assemblage : sans cela, un facteur nommé mais non implémenté serait silencieusement toujours inactif, et le risque serait sous-évalué sans que rien ne le dise."
        },
        "parametres": { "type": "object" },
        "sources": { "type": "array", "minItems": 1 }
      }
    }
  }
}
