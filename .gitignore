node_modules/
# lien symbolique vers l'installation locale de Playwright (prototype/pw)
node_modules

# Sondes jetables du répertoire des harnais : elles servent à mesurer une fois,
# pas à garder. Seuls les harnais nommés dans tout.sh sont versionnés.
prototype/pw/_q*.mjs
prototype/pw/_shot*.mjs
prototype/pw/_taille*.mjs
app/.next/
app/.data/
*.log
.DS_Store
app/coverage/

# ADR-018: the public eval corpus is local-only, never committed
dataset/eval/public/*
!dataset/eval/public/README.md

# Secrets: never committed. The API key lives only in app/.env.local (ADR-020).
.env
.env.local
.env.*.local
app/.env
app/.env.local
app/.env.*.local

# Le catalogue est ENGENDRÉ depuis methodology/ à chaque assemblage — jamais versionné.
prototype/src/_catalogue.gen.js
prototype/src/otto-prototype.html
